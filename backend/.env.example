# Copy this file to .env and fill in your values:
#   cp .env.example .env

OPENAI_API_KEY=sk-your-key-here

# Image edit model. gpt-image-1 works on current OpenAI accounts;
# dall-e-2 edits may no longer be available for all keys.
OPENAI_IMAGE_MODEL=gpt-image-1

# Development: set to true to skip OpenAI and return the sample outline
# from backend/resources/outline-sample.png (fast, no API cost).
DEBUG_SKIP_LLM_STEP=false

# Development: set to true to skip bitmap-to-SVG vectorization and return
# the sample paths file from backend/resources/paths-sample.svg.
DEBUG_SKIP_VECTORIZE_STEP=false

# Development: set to true to skip SVG-to-LeRobotDataset export and return
# the sample replay zip from backend/resources/draw-sample.zip.
DEBUG_SKIP_ROBOT_STEP=false

# Optional overrides for debug sample files
# DEBUG_OUTLINE_SAMPLE_PATH=resources/outline-sample.png
# DEBUG_PATHS_SAMPLE_PATH=resources/paths-sample.svg
# DEBUG_DRAW_SAMPLE_PATH=resources/draw-sample.zip

# Bitmap-to-SVG tuning (no LLM; uses OpenCV + scikit-image + skan)
# VECTORIZE_SIMPLIFY_EPSILON=1.5
# VECTORIZE_MIN_PATH_LENGTH=8
# SVG_PATH_PADDING=0.05

# Robot dataset export (LeRobotDataset v3.0; requires pip install -r backend/requirements-robot.txt)
# ROBOT_FPS=30
# ROBOT_HOME_SHOULDER_PAN=0.0
# ROBOT_HOME_SHOULDER_LIFT=15.0
# Portrait A4 pad laid flat in front of the arm (horizontal orientation).
# Planar IK uses the SO-101 URDF via placo (pip install -r backend/requirements-robot.txt).
# ROBOT_CANVAS_WIDTH_MM=210.0
# ROBOT_CANVAS_HEIGHT_MM=297.0
# ROBOT_CANVAS_MARGIN=0.05
# Near edge offset from robot base as a fraction of A4 length (default 0.8 = 80%).
# ROBOT_CANVAS_NEAR_OFFSET_FRACTION=0.8
# Extra mm added to the near-edge distance from the robot base (margin from folded workspace).
# ROBOT_CANVAS_BASE_CLEARANCE_MM=25.0
# Skip the closest 12% of the near→far canvas axis so line starts stay extended.
# ROBOT_CANVAS_V_NEAR_FRACTION=0.12
# Height of the drawing plane above the robot base (mm).
# ROBOT_CANVAS_PLANE_Z_MM=35.0
# Gripper-down orientation weight after the position-only IK pass (higher = more vertical).
# ROBOT_IK_ORIENTATION_WEIGHT=0.05
# Extended IK seed pose (defaults keep the arm reaching forward over the canvas).
# ROBOT_REACH_SHOULDER_LIFT=15.0
# ROBOT_REACH_ELBOW_FLEX=50.0
# ROBOT_REACH_WRIST_FLEX=-55.0
# Brief pause (frames) at the start/end of each SVG subpath.
# ROBOT_FRAMES_PATH_SETTLE=5
# ROBOT_DRAW_SPEED_MM_S=60.0
# ROBOT_TRAVEL_SPEED_MM_S=150.0
# Pen lift above the canvas plane during inter-stroke moves (mm; arm joints, not gripper).
# ROBOT_TRAVEL_LIFT_MM=15.0
# ROBOT_MIN_DRAW_FRAMES=2
# ROBOT_MIN_TRAVEL_FRAMES=2
