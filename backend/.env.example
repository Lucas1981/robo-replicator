# Copy this file to .env and fill in your values:
#   cp .env.example .env

OPENAI_API_KEY=sk-your-key-here

# Image edit model. gpt-image-1 works on current OpenAI accounts;
# dall-e-2 edits may no longer be available for all keys.
OPENAI_IMAGE_MODEL=gpt-image-1

# Development: set to true to skip OpenAI and always return the sample outline
# from backend/resources/outline-sample.png (fast, no API cost).
DEBUG_SKIP_LLM_STEP=false

# Optional override for the sample outline used when DEBUG_SKIP_LLM_STEP=true
# DEBUG_OUTLINE_SAMPLE_PATH=resources/outline-sample.png
