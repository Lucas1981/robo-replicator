# Copy this file to .env and fill in your values:
#   cp .env.example .env

OPENAI_API_KEY=sk-your-key-here

# Image edit model. gpt-image-1 works on current OpenAI accounts;
# dall-e-2 edits may no longer be available for all keys.
OPENAI_IMAGE_MODEL=gpt-image-1

# Development: set to true to skip OpenAI and return the sample outline
# from backend/resources/outline-sample.png (fast, no API cost).
DEBUG_SKIP_LLM_STEP=false

# Development: set to true to skip bitmap-to-SVG vectorization and return
# the sample paths file from backend/resources/paths-sample.svg.
DEBUG_SKIP_VECTORIZE_STEP=false

# Development: set to true to skip SVG-to-LeRobotDataset export and return
# the sample replay zip from backend/resources/draw-sample.zip.
DEBUG_SKIP_ROBOT_STEP=false

# Optional overrides for debug sample files
# DEBUG_OUTLINE_SAMPLE_PATH=resources/outline-sample.png
# DEBUG_PATHS_SAMPLE_PATH=resources/paths-sample.svg
# DEBUG_DRAW_SAMPLE_PATH=resources/draw-sample.zip

# Bitmap-to-SVG tuning (no LLM; uses OpenCV + scikit-image + skan)
# VECTORIZE_SIMPLIFY_EPSILON=1.5
# VECTORIZE_MIN_PATH_LENGTH=8

# Robot dataset export (LeRobotDataset v3.0; requires pip install -r backend/requirements-robot.txt)
# ROBOT_FPS=30
# ROBOT_HOME_SHOULDER_PAN=0.0
# ROBOT_HOME_SHOULDER_LIFT=15.0
# ROBOT_CANVAS_HALF_EXTENT_PAN=12.0
# ROBOT_CANVAS_HALF_EXTENT_LIFT=10.0
# ROBOT_PEN_UP=10.0
# ROBOT_PEN_DOWN=85.0
